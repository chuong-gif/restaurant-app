{
  "name": "restaurant-app",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm --workspace=packages/server run dev",
    "dev:admin": "npm --workspace=packages/admin run dev",
    "dev:client": "npm --workspace=packages/client run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:admin\" \"npm run dev:client\"",
    "build": "npm run -w packages/server build && npm run -w packages/admin build && npm run -w packages/client build",
    "lint": "eslint \"packages/**/src/**/*.{ts,tsx,js,jsx}\" --fix"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "devDependencies": {
    "@prisma/client": "^6.17.0",
    "@types/node": "^24.8.1",
    "@types/react-redux": "^7.1.34",
    "@types/redux-thunk": "^2.1.32",
    "concurrently": "^8.0.0",
    "eslint": "^8.0.0",
    "prettier": "^2.0.0",
    "prisma": "^6.17.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@esbuild/win32-x64": "^0.25.11",
    "@prisma/client": "^6.17.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@reduxjs/toolkit": "^2.9.1",
    "@types/redux": "^3.6.31",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^0.553.0",
    "react-hook-form": "^7.64.0",
    "react-redux": "^9.2.0",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0"
  }
}
